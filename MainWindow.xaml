<Window x:Class="Blocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocker"
        Height="680"
        Width="900"
        MinHeight="600"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="BLOCKER"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Your personal website blocker"
                       FontSize="14"
                       Foreground="#9CA3AF"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1F2937"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROTECTION STATUS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#9CA3AF"/>
                    <TextBlock x:Name="ProtectionStatus"
                               Text="PROTECTION OFF"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F87171"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="ProtectionDescription"
                               Text="Your blocklist is saved, but websites are not being blocked."
                               FontSize="13"
                               Foreground="#D1D5DB"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="ProtectionButton"
                        Grid.Column="1"
                        Content="Enable protection"
                        Click="ProtectionButton_Click"
                        Width="170"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BLOCKED WEBSITES"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#9CA3AF"/>
                    <TextBlock x:Name="DomainCount"
                               Grid.Row="1"
                               Text="0 domains"
                               FontSize="13"
                               Foreground="#D1D5DB"
                               Margin="0,6,0,12"/>
                    <ListBox x:Name="DomainList"
                             Grid.Row="2"
                             Background="#111827"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="14"
                             Padding="8"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="20"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="MANAGE DOMAINS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#9CA3AF"/>
                    <TextBlock Text="Add a domain"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,18,0,8"/>
                    <TextBox x:Name="DomainInput"
                             Height="38"
                             FontSize="14"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             Background="#111827"
                             Foreground="White"
                             BorderBrush="#374151"
                             CaretBrush="White"
                             ToolTip="example.com"
                             KeyDown="DomainInput_KeyDown"/>
                    <Button Content="Add to blocklist"
                            Click="AddDomainButton_Click"
                            Height="38"
                            Margin="0,10,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                    <Separator Background="#374151" Margin="0,22,0,18"/>
                    <TextBlock Text="Remove selected domain"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <Button Content="Remove selected"
                            Click="RemoveDomainButton_Click"
                            Height="38"
                            Background="#991B1B"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <TextBlock Text="Note: hosts-file blocking applies to exact hostnames. We'll improve subdomain coverage with DNS filtering in a future version."
                               FontSize="11"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Version 0.1.0 | Windows hosts-file protection"
                   FontSize="12"
                   Foreground="#6B7280"
                   Margin="0,18,0,0"/>
    </Grid>
</Window>
